# Default local development mode; no document is sent externally.
# Change AI_PROVIDER to gemini after setting GEMINI_API_KEY.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional shared secret for a trusted school backend. Keep it server-side.
SERVICE_API_KEY=
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20
